# Copy to .env (git-ignored). Everything is optional.

# Where local data lives (SQLite, artifacts, uploaded credentials, logs)
AIDRIVEN_DATA_DIR=data
AIDRIVEN_HOST=127.0.0.1
AIDRIVEN_PORT=8731
AIDRIVEN_RELOAD=false
# Signs per-browser UI storage (language). Change it if you expose the app beyond localhost.
AIDRIVEN_STORAGE_SECRET=change-me

# API keys: prefer saving them in the UI (OS keyring). These are only a fallback.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Encrypts provider API keys stored in Firestore (Fernet). Default: derived from the uploaded
# service account's private key, so any machine with the same service account can decrypt them.
# AIDRIVEN_ENCRYPTION_KEY=
